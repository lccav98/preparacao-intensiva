# =============================================================================
# Ambiente do Painel do Aluno — Matrizes e Vetores (MAT121)
# Copie este arquivo para .env e preencha os valores antes de subir o servidor.
# =============================================================================

# Porta do servidor (Railway/Render injetam PORT automaticamente)
PORT=8090

# Disciplina padrão servida pelo painel
DISCIPLINA_PADRAO=matrizes_vetores

# Endereço de escuta: 0.0.0.0 permite acesso de outros dispositivos na rede
PREP_DASHBOARD_HOST=0.0.0.0

# Diretório do curso Matrizes e Vetores (no Windows use barras normais ou aspas)
# Exemplo Windows: C:/Users/d7opa/Documents/Matrizes e Vetores/Curso_Preparacao_Intensiva_Matrizes_Vetores
PREP_CURSO_MV_DIR=C:/Users/d7opa/Documents/Matrizes e Vetores/Curso_Preparacao_Intensiva_Matrizes_Vetores

# Diretório raiz dos dados de runtime (contém dados/, folhas_emitidas/, spool_email/).
# Vazio = usa a pasta padrão do projeto (automacao_curso/), onde ficam os dados atuais.
# Caminhos relativos são resolvidos a partir da RAIZ DO CURSO (nunca do diretório atual).
PREP_DATA_DIR=

# ———————————————— Autenticação da professora (OBRIGATÓRIA para acesso externo) ————————————————
# E-mail da professora/administradora
PREP_ADMIN_EMAIL=professora@utfpr-prep.local
# Senha de acesso ao painel gerencial (mínimo 6 caracteres)
PREP_ADMIN_PASSWORD=sua_senha_aqui
# Chave secreta para assinar sessões (gera automaticamente se vazio)
PREP_SECRET_KEY=

# ———————————————— E-mail (opcional — se ausente, usa Spool local) ————————————————
PREP_SMTP_HOST=
PREP_SMTP_PORT=587
PREP_SMTP_USER=
PREP_SMTP_PASS=
PREP_SMTP_FROM=tutor-mv@utfpr-prep.local

PREP_IMAP_HOST=
PREP_IMAP_PORT=993
PREP_IMAP_USER=
PREP_IMAP_PASS=
PREP_IMAP_POLL_SEC=15
PREP_WEBHOOK_TOKEN=

# ———————————————— Visão OCR (opcional) ————————————————
GEMINI_API_KEY=
PREP_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# ———————————————— URL pública (para acesso de qualquer lugar) ————————————————
# Ex: https://abc123.ngrok.io  ou  https://seu-app.railway.app
PREP_PUBLIC_URL=
