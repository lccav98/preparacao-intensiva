          "tipo_resposta": "classificacao",
          "esperado": "sim",
          "sinonimos": ["sim", "inversa", "e inversa", "verdadeiro"]
        }
      },
      "exemplo_correto": "(a) [[1, 0], [0, 1]] (b) sim",
      "exemplo_incorreto": "(a) [[1, 1], [0, 1]] (b) nao",
      "dica_erro": "Multiplique linha de A por coluna de B; como AB = I2 (e BA = I2), B e a inversa de A."
    },
    "B06-E02": {
      "tipo_resposta": "matriz",
      "esperado": [[3, -5], [-1, 2]],
