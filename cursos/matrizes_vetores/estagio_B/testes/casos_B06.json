        "n": {
          "tipo_resposta": "numero",
          "esperado": 3
        }
      },
      "exemplo_correto": "m: -5 ; n: 3",
      "exemplo_incorreto": "m: 5 ; n: -3",
      "dica_erro": "Na segunda coluna de AB = I2 temos 3m + 5n = 0 e m + 2n = 1."
    },
