      "exemplo_incorreto": "[[3, 5], [1, 2]]",
      "dica_erro": "Resolva 2a+5c=1, a+3c=0 para a 1a coluna e 2b+5d=0, b+3d=1 para a 2a coluna."
    },
    "B06-E03": {
      "tipo_resposta": "composta",
      "esperado": {
        "m": {
          "tipo_resposta": "numero",
          "esperado": -5
