      "esperado": {
        "a": { "tipo_resposta": "vetor", "esperado": [1, 3] },
        "b": { "tipo_resposta": "vetor", "esperado": [3, 3] },
        "c": {
          "tipo_resposta": "equacao_algebrica",
          "esperado": {
            "variaveis": ["x"],
            "expr": "x + 1",
            "pontos_teste": [[-1]]
          }
        }
      },
      "exemplo_correto": "(a) (1, 3) (b) (3, 3) (c) x = -1",
      "exemplo_incorreto": "(a) (1, 3) (b) (5, 3) (c) x = -3",
      "dica_erro": "De (y-3)^2 = 8(x-1) temos V(1,3), 2p = 8 => p/2 = 2, foco F(3,3) e diretriz x = -1."
    },
    "G05-E02": {
